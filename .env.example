# ---------------------------------------------------------------------------
# mc-club-rag environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=mc-club-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=mc-club-rag

# --- LLM native (Google Gemini) -------------------------------------------
# Only used when GEMINI_API_KEY is set (takes precedence over OpenRouter).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embeddings (local) ----------------------------------------------------
# Prefixes are REQUIRED by e5 models; set both to "" for models without them.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=          # unset/empty => auto-detect
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOC_PREFIX="passage: "

# --- Vector store (Chroma) -------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST=true
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=micro_bot_corpus_e5base

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/mc_club.db
CONVERSATION_DB_PATH=./storage/conversations.db
FEEDBACK_DB_PATH=./storage/feedback.db

# --- Uploads (admin document uploads) --------------------------------------
UPLOAD_DIR=./data/uploads

# --- Auth (required by the API contract) -----------------------------------
# Member requests send:  Authorization: Bearer <MEMBER_TOKEN>
# Admin requests send:   X-Admin-Key: <ADMIN_API_KEY>
MEMBER_TOKEN=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Discord OAuth / JWT (optional bonus, not used yet) --------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Ingestion / RAG tuning ------------------------------------------------
RAW_DATA_DIR=./data/raw
CHUNK_SIZE=900
CHUNK_OVERLAP=130
RETRIEVAL_TOP_K=5
# e5 cosine scores are compressed (~0.7-0.9); calibrate with scripts/evaluate*.py.
# Threshold for English questions.
RETRIEVAL_MIN_SCORE=0.79
# Lower threshold for French/Arabic questions (cross-lingual scores are lower).
RETRIEVAL_MIN_SCORE_MULTILINGUAL=0.76

# --- Hybrid retrieval (BM25 + vectors, fused with RRF) ----------------------
# Off by default: the retriever stays vector-only until you calibrate.
HYBRID_ENABLED=false
# Path of the SQLite FTS5 index (keep it next to the other storage files).
BM25_INDEX_PATH=./storage/bm25.sqlite3
# Keep a lexical candidate when -bm25 >= this value. bm25() is corpus-dependent
# (about -1e-6 on a single document): calibrate with scripts/evaluate.py.
HYBRID_BM25_MIN_SCORE=1.0
# Candidates gathered per index before fusion (always >= RETRIEVAL_TOP_K).
HYBRID_CANDIDATE_POOL=30
# RRF dampening constant; higher = flatter ranking.
HYBRID_RRF_K=60
# true = a candidate must pass BOTH gates (vector and lexical) to be kept.
HYBRID_REQUIRE_BOTH=false

# --- Query rewriting / multi-query (at most ONE extra LLM call) -------------
# Rewriting: turn a weak follow-up into a standalone, keyword-rich query.
QUERY_REWRITE_ENABLED=false
# Best first-pass cosine below this value triggers the rewrite.
# 0.0 = use the language threshold (RETRIEVAL_MIN_SCORE*) instead.
QUERY_REWRITE_MIN_SCORE=0.0
# Hard cap on the rewritten query length.
QUERY_REWRITE_MAX_CHARS=300
# Multi-query: also search N alternative phrasings (same single LLM call).
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=2
MULTI_QUERY_MAX_CHARS=200
# Total budget stays <= 2 LLM calls per question (1 rewrite + 1 answer).
# A 429 is never retried: the rewrite silently degrades to the heuristic.
