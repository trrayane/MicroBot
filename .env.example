# ---------------------------------------------------------------------------
# mc-club-rag environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=mc-club-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=mc-club-rag

# --- Embeddings (local) ----------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Vector store (Chroma) -------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=mc_club_documents

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/mc_club.db

# --- Discord OAuth / membership -------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# --- Auth / security -------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Ingestion / RAG tuning ------------------------------------------------
RAW_DATA_DIR=./data/raw
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
