# ---------------------------------------------------------------------------
# mc-club-rag environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=mc-club-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=mc-club-rag

# --- Embeddings (local) ----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=          # unset/empty => auto-detect
EMBEDDING_NORMALIZE=true
# e5 models require these prefixes; set both to "" for models without them (e.g. bge-m3).
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOC_PREFIX="passage: "

# --- Vector store (Chroma) -------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST=true
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=micro_bot_corpus_e5base

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/mc_club.db
CONVERSATION_DB_PATH=./storage/conversations.db

# --- Auth (required by the API contract) -----------------------------------
# Member requests send:  Authorization: Bearer <MEMBER_TOKEN>
# Admin requests send:   X-Admin-Key: <ADMIN_API_KEY>
MEMBER_TOKEN=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Discord OAuth / JWT (optional bonus, not used yet) --------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Ingestion / RAG tuning ------------------------------------------------
RAW_DATA_DIR=./data/raw
CHUNK_SIZE=900
CHUNK_OVERLAP=130
RETRIEVAL_TOP_K=5
# e5 cosine scores are compressed (~0.7-0.9); recalibrate with scripts/check_scores.py
RETRIEVAL_MIN_SCORE=0.80
