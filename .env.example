# ---------------------------------------------------------------------------
# mc-club-rag environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=mc-club-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- LLM (OpenRouter) ------------------------------------------------------
OPENROUTER_API_KEY=AQ.Ab8RN6LQsmA31pwGzzFkxY5evY7fooBiIvLYPcPHIkx7BJqXnw
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=mc-club-rag

# --- LLM native (Google Gemini) -------------------------------------------
# Only used when GEMINI_API_KEY is set (takes precedence over OpenRouter).
GEMINI_API_KEY=
# Roulette : clés Gemini séparées par des virgules — sur 429 (quota atteint)
# la clé est mise en pause (retryDelay ou 10 min) et la requête rejouée sur
# la clé suivante du pool. GEMINI_API_KEY est ajoutée en fin de pool.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
# --- Embeddings (local) ----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
EMBEDDING_NORMALIZE=true

# --- Vector store (Chroma) -------------------------------------------------
CHROMA_COLLECTION=micro_bot_corpus_e5base

# --- Ingestion / RAG tuning ------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=130
RETRIEVAL_TOP_K=5
# Calibre sur les corpus labellise et live (scripts/evaluate*.py)
RETRIEVAL_MIN_SCORE=0.79
RETRIEVAL_MIN_SCORE_MULTILINGUAL=0.76

# --- Hybrid search (BM25 + vector) -----------------------------------------
HYBRID_ENABLED=true
HYBRID_RRF_K=60
HYBRID_CANDIDATE_POOL=20
HYBRID_BM25_MIN_SCORE=1.0
HYBRID_REQUIRE_BOTH=false

# --- Cross-encoder reranking -----------------------------------------------
RERANK_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL_SIZE=20
RERANK_MIN_SCORE=-5.0

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/mc_club.db
CONVERSATION_DB_PATH=./storage/conversations.db

# --- Auth (required by the API contract) -----------------------------------
# Member requests send:  Authorization: Bearer <MEMBER_TOKEN>
# Admin requests send:   X-Admin-Key: <ADMIN_API_KEY>
MEMBER_TOKEN=dev-member-token
ADMIN_API_KEY=123
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Discord OAuth / JWT ----------------------------------------------------
DISCORD_CLIENT_ID=1558181627291770971
DISCORD_CLIENT_SECRET=WFzKNgjospJIl3dOkk7agfULZhV5-MuW
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
DISCORD_GUILD_ID=1282095800079351851
DISCORD_MEMBER_ROLE_ID=
DISCORD_ADMIN_ROLE_IDS=1282097993054687263,1282098162235871272
DISCORD_ADMIN_USER_IDS=
DISCORD_BOT_TOKEN=
JWT_SECRET_KEY=W2E0djPEpuJNdgHzADJHY4pgeuxZpDb_viX3LE06rW1GRKZBoctV6jWA4KSaZmay
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
FRONTEND_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
USERS_DB_PATH=./storage/users.db
